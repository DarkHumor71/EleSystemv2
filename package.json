{
  "name": "elesystem",
  "version": "1.0.0",
  "main": "server.js",
  "scripts": {
    "start": "node server",
    "server": "cd backend && nodemon --env-file .env server",
    "client": "cd client && npm run dev",
    "dev": "concurrently \"npm run server\" \"npm run client\""
  },
  "devDependencies": {
    "concurrently": "^9.2.0",
    "ts-node": "^10.9.2"
  },
  "dependencies": {
    "nodemon": "^3.1.10"
  }
}
