{
  "compilerOptions": {
    "target": "es2020", // Or a suitable ES version for your environment
    "module": "CommonJS", // Or "NodeNext" for newer Node.js versions
    "outDir": "./dist",
    "rootDir": "./src",
    "strict": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "forceConsistentCasingInFileNames": true
  },
  "include": ["src/**/*.ts"],
  "exclude": ["node_modules"]
}
